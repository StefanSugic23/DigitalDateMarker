ThirtyCustomDate x
(y m d) ← x

⎕←'Date Produced: ' , x
:If (m>12)∨(d>31)
⎕←'Wrong Date'
:ElseIf ((30+d)>31) ∧ ((m=1)∨(m=3)∨(m=5)∨(m=7)∨(m=8)∨(m=10))

⎕← 'Date of expiration: ' , y, (1+m), ((30+d)-31)

:ElseIf ((m=4)∨(m=6)∨(m=9)∨(m=11))
⎕←  'Date of expiration: ' , y, (1+m), d
:ElseIf (m=2) ∧ ((0=4|y)=0)
⎕←'Date of expiration: ' , y, (1+m), ((30+d)-28)
:ElseIf (m=2) ∧ ((0=4|y)=1)
⎕←'Date of expiration: ' , y, (1+m), ((30+d)-29)
:ElseIf ((30+d)>31) ∧ (m=12)
⎕←'Date of expiration: ' , (y+1), (m-11), ((30+d)-31)
:Else
⎕←'Date of Expiration: ' , y, m, (30+ d)
:EndIf
