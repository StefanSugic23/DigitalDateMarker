x CustomHour y
(h m) ← x
(h1 m1) ← y

:If ∨/(h1>24) (h>24) (m1>60) (m>60)
⎕←'Invalid time input'
:ElseIf ∧/((m+m1)>60)  ((h1 + h + 1)≤23) (((m+m1)-60)<10)
 ⎕←'Old time: ', ⍕h1,':',2↑⍕m1
 ⎕←'New time: ',⍕(h+ h1+ 1),':',⍕((m+m1)-60)
 :ElseIf ∧/((m+m1)>60)  ((h1 + h + 1)≤23) (((m+m1)-60)≥10)
 ⎕←'Old time: ', ⍕h1,':',2↑⍕m1
 ⎕←'New time: ',⍕(h+ h1+ 1),':',⍕((m+m1)-60)
 :Else
 ⎕←'Old time: ', (⍕h1),':',(⍕m1)
 ⎕←'New time: ', (⍕(h+h1)),':',(2↑⍕(m+m1))

:EndIf
